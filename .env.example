# ==============================================================================
# MedCode AI - Environment Configuration Example
# ==============================================================================

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://medcode_user:medcode_secure_pass_2026@localhost:5432/medcode_db
SQLITE_FALLBACK_URL=sqlite:///./medcode_local.db

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_key_for_production_deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service Settings
AI_MODE=demo  # 'demo' for mock synthetic models without API keys, 'live' for real LLMs
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Zoom Integration Settings (Optional: demo mode is active if empty)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
